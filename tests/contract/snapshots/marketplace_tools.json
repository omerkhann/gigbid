{
  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": null
    },
    "description": "Save a proposal as a draft on the marketplace. Nothing is sent and no Connects are spent.\n        Calling again for the same job updates the draft.",
    "input": {
      "properties": {
        "bid_amount": {
          "description": "USD total (fixed) or USD/hour (hourly)",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Bid Amount",
          "type": "number"
        },
        "cover_letter": {
          "maxLength": 5000,
          "minLength": 50,
          "title": "Cover Letter",
          "type": "string"
        },
        "idempotency_key": {
          "description": "Unique per intended action. Retrying with the same key never repeats the action.",
          "maxLength": 100,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_\\-:.]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "description": "Marketplace job id, e.g. job-1a2b3c4d5e6f",
          "pattern": "^[A-Za-z0-9_\\-:.~]{3,80}$",
          "title": "Job Id",
          "type": "string"
        },
        "screening_answers": {
          "default": [],
          "items": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Screening Answers",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "bid_amount",
        "idempotency_key"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "StatusEvent": {
          "properties": {
            "at": {
              "title": "At",
              "type": "string"
            },
            "status": {
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "status",
            "at"
          ],
          "title": "StatusEvent",
          "type": "object"
        }
      },
      "properties": {
        "bid_amount": {
          "title": "Bid Amount",
          "type": "number"
        },
        "bid_type": {
          "enum": [
            "fixed",
            "hourly"
          ],
          "title": "Bid Type",
          "type": "string"
        },
        "connects_cost": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Connects Cost"
        },
        "cover_letter": {
          "title": "Cover Letter",
          "type": "string"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/StatusEvent"
          },
          "title": "History",
          "type": "array"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "screening_answers": {
          "items": {
            "type": "string"
          },
          "title": "Screening Answers",
          "type": "array"
        },
        "status": {
          "enum": [
            "draft",
            "submitted",
            "viewed",
            "replied",
            "interview",
            "hired",
            "lost"
          ],
          "title": "Status",
          "type": "string"
        },
        "submitted_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Submitted At"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thread Id"
        }
      },
      "required": [
        "proposal_id",
        "job_id",
        "status",
        "bid_amount",
        "bid_type",
        "cover_letter",
        "screening_answers",
        "connects_cost",
        "submitted_at",
        "history",
        "thread_id"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "title": "Create proposal draft"
  },
  "get_client_history": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": null
    },
