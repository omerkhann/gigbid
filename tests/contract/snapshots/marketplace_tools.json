          "properties": {
            "job_id": {
              "title": "Job Id",
              "type": "string"
            },
            "posted_at": {
              "title": "Posted At",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "job_id",
            "title",
            "posted_at"
          ],
          "title": "PostedJob",
          "type": "object"
        }
      },
      "properties": {
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country"
        },
        "enterprise": {
          "title": "Enterprise",
          "type": "boolean"
        },
        "feedback_count": {
          "title": "Feedback Count",
          "type": "integer"
        },
        "jobs_posted": {
          "items": {
            "$ref": "#/$defs/PostedJob"
          },
          "title": "Jobs Posted",
          "type": "array"
        },
        "payment_verified": {
          "title": "Payment Verified",
          "type": "boolean"
        },
        "rating": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "None means no reviews yet (a new client), not a bad client.",
          "title": "Rating"
        },
        "total_spent": {
          "title": "Total Spent",
          "type": "number"
        }
      },
      "required": [
        "client_id",
        "payment_verified",
        "total_spent",
        "rating",
        "feedback_count",
        "country",
        "enterprise",
        "jobs_posted"
      ],
      "title": "ClientHistory",
      "type": "object"
    },
    "title": "Get client history"
  },
