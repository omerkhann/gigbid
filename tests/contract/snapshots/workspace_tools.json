{
  "create_email_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": null
    },
    "description": "Save an email as a draft for the freelancer to review and send themselves. Never sends.",
    "input": {
      "properties": {
        "body": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 100,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_\\-:.]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "subject": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "description": "Recipient name or address",
          "maxLength": 200,
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to",
        "subject",
        "body",
        "idempotency_key"
      ],
      "title": "create_email_draftArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "draft_id": {
          "title": "Draft Id",
          "type": "string"
        },
        "status": {
          "const": "draft",
          "default": "draft",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "to",
        "subject",
        "body",
        "created_at"
      ],
      "title": "EmailDraft",
      "type": "object"
    },
    "title": "Create email draft"
  },
  "create_interview_hold": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": null
    },
    "description": "Block a slot on the freelancer's calendar as tentative while the client confirms.\n        Fails with slot_unavailable if the time is busy or outside working hours.",
    "input": {
      "properties": {
        "duration_minutes": {
          "default": 30,
          "maximum": 120,
          "minimum": 15,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 100,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_\\-:.]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "ref": {
          "description": "What it is for, e.g. a thread id",
          "maxLength": 80,
          "minLength": 3,
          "title": "Ref",
          "type": "string"
        },
        "start": {
          "description": "ISO 8601 datetime with timezone, e.g. 2026-11-17T10:30:00+05:00",
          "title": "Start",
          "type": "string"
        },
        "title": {
          "default": "Interview (tentative)",
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "start",
        "ref",
        "idempotency_key"
      ],
      "title": "create_interview_holdArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "end_utc": {
          "title": "End Utc",
          "type": "string"
        },
        "hold_id": {
          "title": "Hold Id",
          "type": "string"
        },
        "ref": {
          "description": "What the hold is for, e.g. a marketplace thread id",
          "title": "Ref",
          "type": "string"
        },
        "start_utc": {
          "title": "Start Utc",
          "type": "string"
        },
        "status": {
          "enum": [
            "tentative",
            "released"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "hold_id",
        "title",
        "ref",
        "start_utc",
        "end_utc",
        "status"
      ],
      "title": "Hold",
      "type": "object"
    },
    "title": "Create tentative interview hold"
  },
  "get_free_slots": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": null
    },
    "description": "Free slots in the freelancer's working hours (at least 2 hours from now), at most two per day,\n        avoiding meetings and existing holds. Times are shown in UTC, local time and the client's timezone.",
    "input": {
      "properties": {
        "client_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IANA timezone, e.g. America/New_York",
          "title": "Client Timezone"
        },
        "days": {
          "default": 5,
          "description": "How many days ahead to search",
          "maximum": 14,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "duration_minutes": {
          "default": 30,
          "maximum": 120,
          "minimum": 15,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "earliest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 datetime with timezone, e.g. 2026-11-17T10:30:00+05:00",
          "title": "Earliest"
        },
        "max_slots": {
          "default": 6,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Slots",
          "type": "integer"
        }
      },
      "title": "get_free_slotsArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Slot": {
          "properties": {
            "end_utc": {
              "title": "End Utc",
              "type": "string"
            },
            "start_client": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start in the client's timezone, if one was given",
              "title": "Start Client"
            },
            "start_local": {
              "description": "Start in the freelancer's timezone",
              "title": "Start Local",
              "type": "string"
            },
            "start_utc": {
              "title": "Start Utc",
              "type": "string"
            }
          },
          "required": [
            "start_utc",
            "end_utc",
            "start_local",
            "start_client"
          ],
          "title": "Slot",
          "type": "object"
        }
      },
      "properties": {
        "duration_minutes": {
          "title": "Duration Minutes",
          "type": "integer"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Slots",
          "type": "array"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "duration_minutes",
        "slots"
      ],
      "title": "FreeSlots",
      "type": "object"
    },
    "title": "Get free interview slots"
  },
