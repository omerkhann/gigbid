  "release_hold": {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": null
    },
    "description": "Free a tentative hold, e.g. when the client picked another time.",
    "input": {
      "properties": {
        "hold_id": {
          "pattern": "^hold-[0-9a-f]{12}$",
          "title": "Hold Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 100,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_\\-:.]+$",
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "hold_id",
        "idempotency_key"
      ],
      "title": "release_holdArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "end_utc": {
          "title": "End Utc",
          "type": "string"
        },
        "hold_id": {
          "title": "Hold Id",
          "type": "string"
        },
        "ref": {
          "description": "What the hold is for, e.g. a marketplace thread id",
          "title": "Ref",
          "type": "string"
        },
        "start_utc": {
          "title": "Start Utc",
          "type": "string"
        },
        "status": {
          "enum": [
            "tentative",
            "released"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "hold_id",
        "title",
        "ref",
        "start_utc",
        "end_utc",
        "status"
      ],
      "title": "Hold",
      "type": "object"
    },
    "title": "Release interview hold"
